
{
  "rule_id": "R001",
  "name": "Pod Traffic Flood",
  "description": "Mitigates excessive incoming traffic to a pod",
  "enabled": true,
  "priority": 50,

  "conditions": {
    "issue_type": "traffic_flood",
    "location_type": "pod",
    "minimum_severity": "low"
  },

  "required_Actions": [
    "limit_ingress",
    "block_source_ip"
  ],

  "required_Validations": [],

  "tiers": {
    "1": {
      "name": "Limit Ingress to Baseline",
      "action": "limit_ingress",
      "parameters": {
        "limit": "baseline"
      },
      "validation": null,
      "verification_delay_seconds": 0,

      "escalation": {
        "logic": "OR",
        "criteria": [
          {
            "type": "detection_agent_increase"
          }
        ]
      },

      "deescalation": {
        "logic": "OR",
        "criteria": [
          {
            "type": "detection_agent_decrease"
          }
        ]
      }
    },

    "2": {
      "name": "Restrict Ingress",
      "action": "limit_ingress",
      "parameters": {
        "limit": "restrictive"
      },
      "validation": null,
      "verification_delay_seconds": 0,

      "escalation": {
        "logic": "OR",
        "criteria": [
          {
            "type": "detection_agent_increase"
          }
        ]
      },

      "deescalation": {
        "logic": "OR",
        "criteria": [
          {
            "type": "detection_agent_decrease"
          }
        ]
      }
    },

    "3": {
      "name": "Block Source IP",
      "action": "block_source_ip",
      "parameters": {},
      "validation": null,
      "verification_delay_seconds": 0,

      "escalation": {
        "logic": "OR",
        "criteria": []
      },

      "deescalation": {
        "logic": "OR",
        "criteria": [
          {
            "type": "detection_agent_decrease"
          }
        ]
      }
    }
  },

  "on_execution_failure": "manual_review",
  "on_resolution": "begin_recovery",
  "on_max_escalation": "manual_review"
}
